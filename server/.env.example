# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Database (use the docker-compose service name "db" when running both in docker)
DATABASE_URL=postgres://binch:binch@localhost:5432/binch

# Redirect-Token-Lebensdauer (Sekunden) — Default: 30 Tage
REDIRECT_TOKEN_TTL_SECONDS=2592000

# === Shared (RapidAPI Marketplace) ===
# Wird aktuell für Google Flights (FLIGHT) verwendet.
RAPIDAPI_KEY=

# === FLIGHT providers (zusätzlich) ===
SEARCHAPI_API_KEY=
# === TRAIN providers ===
TRAINLINE_API_KEY=
DB_VENDO_API_KEY=

# === BUS providers ===
FLIXBUS_API_KEY=
BUSBUD_API_KEY=

# === CRUISE providers ===
CRUISEDIRECT_API_KEY=

# CORS-Allowlist für Prod (kommasepariert). Ungesetzt = Dev-Modus (alle Origins).
# Beim Hetzner-Deployment setzen, z.B.:
# CORS_ORIGINS=https://app.binch.example

# --- Anmeldung über Apple und Google -----------------------------------------
# Kommagetrennt. ALLE Client-IDs, die zu dieser App gehören (Google vergibt pro
# Plattform eine eigene). Diese Liste IST die Prüfung, die verhindert, dass ein
# gültiges Token einer fremden App als Anmeldung durchgeht — es dürfen also nur
# die eigenen darinstehen. Fehlt die Variable, antwortet /api/auth/oauth mit 503.
GOOGLE_CLIENT_IDS=
# Für Apple die Bundle-ID der App.
APPLE_CLIENT_IDS=

# ── Preis-Alarme: Zustellung über Firebase ───────────────────────────────────
# Der Dienstkontoschlüssel ist ein ECHTES Geheimnis — anders als die
# google-services.json der App, die in jeder APK steckt. Mit ihm kann man im
# Namen des Firebase-Projekts Meldungen zustellen. Nie ins Repository.
#
# Zu holen unter: Firebase-Konsole → Projekteinstellungen → Dienstkonten →
# „Neuen privaten Schlüssel generieren". Ergebnis ist eine JSON-Datei.
#
# ZWEI Wege, einer reicht:
#   a) Die JSON-Datei irgendwo ablegen und den Pfad hier eintragen:
#        GOOGLE_APPLICATION_CREDENTIALS=/pfad/zu/serviceAccount.json
#      Im Container muss die Datei dann eingehängt sein (volume).
#   b) Den kompletten JSON-Inhalt einzeilig hier hinterlegen — praktischer,
#      wenn der Server in einem Container ohne eigenes Dateisystem läuft:
#        FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
#
# Ist beides leer, läuft der Server normal weiter: Alarme werden angelegt und
# geprüft, aber nichts wird zugestellt. Er sagt das beim ersten Versuch im Log.
# GOOGLE_APPLICATION_CREDENTIALS=
# FIREBASE_SERVICE_ACCOUNT=
