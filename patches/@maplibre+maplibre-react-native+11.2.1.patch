+package org.maplibre.android.maps;
+
+/**
+ * Binch: Zugang zu MapLibres Schalter „Geste läuft" für das eigene Ausrollen
+ * (`MLRNMapView.FlingDriver`).
+ *
+ * Warum der Schalter gebraucht wird: MapLibre zeichnet anders, solange sich
+ * die Kamera ändert (`TransformState::isChanging()` = Drehen, Zoomen, Schieben
+ * oder Geste). Nur dann werden Symbole weich („linear") abgetastet und das
+ * Luftbild stufenlos verschoben. Steht die Kamera laut MapLibre still, rasten
+ * Symbole und Luftbild auf ganze Bildpunkte ein — im Stand richtig, beim
+ * Gleiten ein Zittern. Das eigene Ausrollen verschiebt mit `scrollBy` ohne
+ * Animation; MapLibre hält die Kamera dabei für ruhend, weil der Finger schon
+ * weg ist. Während des Ausrollens wird die Geste deshalb weiter als laufend
+ * gemeldet, genau wie beim Ziehen.
+ *
+ * Die Klasse liegt in MapLibres Paket, weil `getTransform()` und
+ * `setGestureInProgress()` paketintern sind — derselbe Aufruf, den MapLibres
+ * `MapGestureDetector` beim Aufsetzen und Loslassen macht. Reflection wäre
+ * nach R8 (Umbenennen) nicht verlässlich.
+ */
+public final class BinchGestureBridge {
+  private BinchGestureBridge() {}
+
+  public static void setGestureInProgress(MapLibreMap map, boolean inProgress) {
+    // Beim Zurücksetzen frischt MapLibre dabei auch die zwischengespeicherte
+    // Kameraposition auf — `scrollBy` tut das nicht. Ohne das meldete
+    // `onRegionDidChange` am Ende des Ausrollens die Stelle des Loslassens.
+    map.getTransform().setGestureInProgress(inProgress);
+  }
+}
