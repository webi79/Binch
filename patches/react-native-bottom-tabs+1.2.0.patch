diff --git a/node_modules/react-native-bottom-tabs/android/build/intermediates/merged_res/release/mergeReleaseResources/color/m3_card_ripple_color.xml b/node_modules/react-native-bottom-tabs/android/build/intermediates/merged_res/release/mergeReleaseResources/color/m3_card_ripple_color.xml
