diff --git a/include/mln/shaders/gl/atmosphere.hpp b/include/mln/shaders/gl/atmosphere.hpp
index 1da1b82c..3994de49 100644
--- a/include/mln/shaders/gl/atmosphere.hpp
+++ b/include/mln/shaders/gl/atmosphere.hpp
@@ -39,8 +39,10 @@ layout(std140) uniform AtmospherePropsUBO {
 } atmosphere;
 
 const float PI = 3.141592653589793;
-const int PRIMARY_STEPS = 5;
-const int LIGHT_STEPS = 3;
+// Binch: 4 × 2 statt 5 × 3 Schritte — kaum ein Unterschied im Bild, gut die Hälfte der
+// Rechenarbeit je Bildpunkt (der Durchgang deckt den ganzen Schirm).
+const int PRIMARY_STEPS = 4;
+const int LIGHT_STEPS = 2;
 const float EARTH_RADIUS = 6371000.0;
 const float ATMOSPHERE_RADIUS = 6471000.0;
 
@@ -127,12 +129,134 @@ vec4 scatter(vec3 direction, vec3 origin, vec3 sun) {
     return vec4(color, opacity);
 }
 
+// --- Binch: Weltraum, Sterne, Milchstraße und Tag-und-Nacht-Schatten -------
+// Alles im selben Vollbild-Durchgang wie die Atmosphäre: Der Shader weiß hier
+// ohnehin, ob ein Sichtstrahl die Erde trifft oder ins All geht.
+
+float binch_hash13(vec3 p) {
+    p = fract(p * 0.1031);
+    p += dot(p, p.zyx + 31.32);
+    return fract((p.x + p.y) * p.z);
+}
+
+vec3 binch_hash33(vec3 p) {
+    p = fract(p * vec3(0.1031, 0.1030, 0.0973));
+    p += dot(p, p.yxz + 33.33);
+    return fract((p.xxy + p.yxx) * p.zyx);
+}
+
+// Eine Sternenschicht: je Zelle eines Gitters höchstens ein Stern, fest im Raum.
+vec3 binch_star_layer(vec3 d, float cells, float density, float size, float bright, float pixel) {
+    vec3 p = d * cells;
+    vec3 cell = floor(p);
+    vec3 h = binch_hash33(cell);
+    if (h.x > density) return vec3(0.0);
+    // Mitten in der Zelle, damit kein Stern an der Zellgrenze abgeschnitten wird.
+    vec3 star = normalize(cell + 0.3 + 0.4 * binch_hash33(cell + 7.7));
+    float dist = length(d - star);
+    float radius = max(pixel * size, 1e-6);
+    // Viele schwache, wenige helle — wie am echten Himmel.
+    float magnitude = pow(h.y, 9.0) * bright + 0.07 * bright;
+    vec3 tint = mix(vec3(0.72, 0.82, 1.0), vec3(1.0, 0.88, 0.72), h.z);
+    return tint * magnitude * exp(-(dist * dist) / (radius * radius));
+}
+
+// Die Milchstraße: ein echtes Foto (ESO/S. Brunier, CC BY 4.0) in galaktischen
+// Koordinaten, ±50° um die galaktische Ebene (`binch_milkyway.hpp`). Der Himmel
+// steht fest zur Erde — wer die Kugel dreht, sieht ihn mitwandern, wie in Google
+// Earth. Ausgerichtet wie der echte Himmel zur Sternzeit 5,1 h (galaktischer
+// Nordpol bei RA 192,86° / Dek +27,13°, Zentrum bei RA 266,40° / Dek −28,94°):
+// Dann steht das helle Zentrum der Milchstraße schräg hinter der Kugel, wenn man
+// auf Europa schaut.
+uniform sampler2D u_sky;
+// Helligkeit des Fotos: zurückhaltend wie in Google Earth.
+const float BINCH_MILKY_WAY_GAIN = 0.55;
+const vec3 BINCH_GALACTIC_NORTH = vec3(0.7968, 0.4560, -0.3965);
+const vec3 BINCH_GALACTIC_CENTER = vec3(-0.1520, -0.4838, -0.8618);
+const vec3 BINCH_GALACTIC_EAST = vec3(-0.5849, 0.7470, -0.3162);
+// 50°: so weit reicht das Foto über und unter die Ebene.
+const float BINCH_SKY_HALF_HEIGHT = 0.8726646;
+
+vec3 binch_milky_way(vec3 d) {
+    float b = asin(clamp(dot(d, BINCH_GALACTIC_NORTH), -1.0, 1.0));
+    float l = atan(dot(d, BINCH_GALACTIC_EAST), dot(d, BINCH_GALACTIC_CENTER));
+    vec2 uv = vec2(0.5 - l / (2.0 * PI), 0.5 - 0.5 * b / BINCH_SKY_HALF_HEIGHT);
+    // Ohne Mip-Stufen: LOD 0 fest, dann stört die Naht bei l = ±180° nicht.
+    vec3 photo = textureLod(u_sky, uv, 0.0).rgb;
+    // Den Himmelshintergrund des Fotos abziehen (Median 8/255) — Schwarz bleibt schwarz.
+    photo = max(photo - 0.035, 0.0);
+    // Zum Rand des Ausschnitts weich auslaufen; dort ist das Foto ohnehin fast schwarz.
+    return photo * (1.0 - smoothstep(0.80, 1.0, abs(b) / BINCH_SKY_HALF_HEIGHT));
+}
+
+vec3 binch_space(vec3 d, float pixel) {
+    vec3 photo = binch_milky_way(d);
+    // Im Band stehen mehr Sterne, wie am echten Himmel.
+    float boost = 1.0 + 6.0 * dot(photo, vec3(0.2126, 0.7152, 0.0722));
+    vec3 stars = binch_star_layer(d, 420.0, 0.10 * boost, 0.75, 0.45, pixel)
+               + binch_star_layer(d, 150.0, 0.12 * boost, 0.95, 0.70, pixel)
+               + binch_star_layer(d, 45.0, 0.10, 1.25, 1.30, pixel);
+    // Nicht reines Schwarz: ein Hauch Nachtblau.
+    return vec3(0.004, 0.006, 0.013) + photo * BINCH_MILKY_WAY_GAIN + stars;
+}
+
 void main() {
     vec3 camera = atmosphere.camera_position.xyz * EARTH_RADIUS;
-    vec4 color = scatter(v_view_direction, camera, atmosphere.sun_position.xyz);
+    vec3 direction = normalize(v_view_direction);
+    // Vor jeder Verzweigung: Ableitungen nur im gleichförmigen Ablauf.
+    float pixel = length(fwidth(direction));
+
+    // Binch: Der Durchgang läuft ZWEIMAL (`SkyPass`). Als HINTERGRUND vor allen Ebenen
+    // (camera_position.w = 1) zeichnet er nur, was ins All geht — Sterne, Milchstraße,
+    // Schein —, als ÜBERZUG nach den Ebenen (w = 0) nur Dunst und Nachtschatten über der
+    // Kugel. In einem einzigen Durchgang nach den Ebenen übermalte das deckende All alles,
+    // was über den Erdrand hinausragt: Die Flugbögen in der Luft verschwanden dort,
+    // besonders bei geneigter Karte. Jeder Bildpunkt rechnet den teuren Teil nur einmal.
+    vec2 ground = ray_sphere_intersection(camera, direction, EARTH_RADIUS);
+    bool hitsGround = ground.x <= ground.y && ground.x > 0.0;
+    if (hitsGround == (atmosphere.camera_position.w > 0.5)) {
+        fragColor = vec4(0.0);
+        return;
+    }
+
+    // Die Sonne steht relativ zur KAMERA — links vorne, etwas oben —, damit die
+    // Erde aussieht wie aus dem Fenster einer Raumstation: Licht von links, die
+    // Nachtseite am rechten Rand. Rechts/oben aus der inversen Projektion.
+    vec4 c0 = atmosphere.inv_view_projection * vec4(0.0, 0.0, 0.0, 1.0);
+    vec4 cr = atmosphere.inv_view_projection * vec4(1.0, 0.0, 0.0, 1.0);
+    vec4 cu = atmosphere.inv_view_projection * vec4(0.0, 1.0, 0.0, 1.0);
+    vec3 right = normalize(cr.xyz / cr.w - c0.xyz / c0.w);
+    vec3 up = normalize(cu.xyz / cu.w - c0.xyz / c0.w);
+    vec3 toward = normalize(atmosphere.camera_position.xyz);
+    vec3 sun = normalize(-0.78 * right + 0.30 * up + 0.55 * toward);
+
+    vec4 color = scatter(direction, camera, sun);
     color.rgb = 1.0 - exp(-color.rgb);
     color = pow(color, vec4(1.0 / 2.2));
-    fragColor = vec4(color.rgb, 1.0 - color.a) * atmosphere.sun_position.w;
+
+    float coverage = 1.0 - color.a;
+    vec3 rgb = color.rgb;
+    if (hitsGround) {
+        // Tag und Nacht: weicher Übergang, die Nachtseite dunkel, nicht schwarz.
+        vec3 normal = normalize(camera + direction * ground.x);
+        float light = dot(normal, sun);
+        float night = (1.0 - smoothstep(-0.35, 0.40, light)) * 0.82;
+        // Der Dunst über dem Boden nur gedämpft — sonst wirkt die ganze Kugel
+        // milchig; am Rand (lange Wege durch die Luft) bleibt er kräftig.
+        rgb *= 0.55 * (1.0 - night * 0.7);
+        coverage = 1.0 - (1.0 - coverage * 0.5) * (1.0 - night);
+    } else {
+        // Ins All: der eigene Nachthimmel, durch die Atmosphäre gedämpft.
+        rgb += binch_space(direction, pixel) * color.a;
+        // Ein weicher blauer Schein knapp außerhalb des Erdrands — die dünne
+        // Lufthülle allein ist auf diese Entfernung nur ein Strich.
+        float along = max(-dot(camera, direction), 0.0);
+        float nearest = length(camera + direction * along) / EARTH_RADIUS;
+        float halo = exp(-(nearest - 1.0) / 0.03) * step(1.0, nearest);
+        rgb += vec3(0.32, 0.55, 1.0) * halo * 0.2;
+        coverage = 1.0;
+    }
+    fragColor = vec4(rgb, coverage) * atmosphere.sun_position.w;
 }
 )";
 };
diff --git a/include/mln/shaders/gl/line.hpp b/include/mln/shaders/gl/line.hpp
index c2d06bd4..a0c264ef 100644
--- a/include/mln/shaders/gl/line.hpp
+++ b/include/mln/shaders/gl/line.hpp
@@ -49,7 +49,7 @@ layout (std140) uniform LineEvaluatedPropsUBO {
     lowp float u_blur;
     lowp float u_opacity;
     mediump float u_gapwidth;
-    lowp float u_offset;
+    highp float u_offset;
     mediump float u_width;
     lowp float u_floorwidth;
     lowp float props_pad1;
@@ -77,7 +77,7 @@ out lowp float opacity;
 layout (location = 5) in mediump vec2 a_gapwidth;
 #endif
 #ifndef HAS_UNIFORM_u_offset
-layout (location = 6) in lowp vec2 a_offset;
+layout (location = 6) in highp vec2 a_offset;
 #endif
 #ifndef HAS_UNIFORM_u_width
 layout (location = 7) in mediump vec2 a_width;
@@ -85,6 +85,19 @@ layout (location = 7) in mediump vec2 a_width;
 
 #ifdef PROJECTION_GLOBE
 out float v_tile_x;
+
+// Binch: Sichtbarkeit eines GEHOBENEN Bogenpunkts. Die Horizontebene des Globus gilt nur für Punkte am
+// Boden; ein Punkt in der Luft ist sichtbar, solange die Sichtlinie von der Kamera die Kugel verfehlt —
+// sonst endete ein Bogen hart am Kugelrand, statt über ihn hinauszuragen. Gibt wie
+// `globeComputeClippingZ` unter 1 für sichtbar, über 1 für verdeckt zurück, stetig an der Grenze.
+float binchArcClipZ(vec3 p) {
+    // Die Ebene ist (n, -1/|Kamera|) mit n zur Kamera: daraus die Kamera in Kugelradien.
+    vec3 camera = -u_projection_clipping_plane.xyz / u_projection_clipping_plane.w;
+    vec3 sight = p - camera;
+    float t = clamp(-dot(camera, sight) / dot(sight, sight), 0.0, 1.0);
+    float miss = length(camera + sight * t) - 1.0;
+    return clamp(1.0 - (miss + 0.002) * 8.0, 0.0, 2.0);
+}
 #endif
 
 void main() {
@@ -109,9 +122,9 @@ mediump float gapwidth = unpack_mix_vec2(a_gapwidth, u_gapwidth_t);
 mediump float gapwidth = u_gapwidth;
 #endif
     #ifndef HAS_UNIFORM_u_offset
-lowp float offset = unpack_mix_vec2(a_offset, u_offset_t);
+highp float offset = unpack_mix_vec2(a_offset, u_offset_t);
 #else
-lowp float offset = u_offset;
+highp float offset = u_offset;
 #endif
     #ifndef HAS_UNIFORM_u_width
 mediump float width = unpack_mix_vec2(a_width, u_width_t);
@@ -119,6 +132,30 @@ mediump float width = unpack_mix_vec2(a_width, u_width_t);
 mediump float width = u_width;
 #endif
 
+    // Binch: ein FLUGBOGEN IN DER LUFT — nur in Ebenen, deren ID mit „binch-arc"
+    // beginnt (`LineLayerTweaker` setzt dann `props_pad2`). Die Höhe des Scheitels
+    // kommt in Kilometern über `line-gap-width` (ein Bogen hat keine Lücke; so ist
+    // sie datengetrieben und zoomabhängig), der Fortschritt entlang des ganzen
+    // Fluges aus der Linien-Metrik der Quelle (`lineMetrics`): Höhe · sin(π · t).
+    // Die Linie bleibt eine Linie — glatt und geglättet wie am Boden, nur gehoben.
+    // Dazu die Mercator-Länge des ganzen Fluges über `line-offset` (ein Bogen ist nicht
+    // versetzt): Sie braucht das Band im Bildschirmraum für die Richtung samt Steigung.
+    const highp float BINCH_PI = 3.141592653589793;
+    bool binchArc = props_pad2 > 0.5;
+    highp float binchElevation = 0.0;
+    highp float binchApexKm = 0.0;
+    highp float binchProgress = 0.0;
+    highp float binchMercatorLength = 0.0;
+    if (binchArc) {
+        binchProgress = clamp((floor(a_data.z / 4.0) + a_data.w * 64.0) * 2.0 / 32767.0, 0.0, 1.0);
+        // Erst in highp hinüber: Kilometer · 1000 sprengten sonst mediump (bis 65504).
+        binchApexKm = gapwidth;
+        binchMercatorLength = offset;
+        binchElevation = binchApexKm * 1000.0 * sin(BINCH_PI * binchProgress);
+        gapwidth = 0.0;
+        offset = 0.0;
+    }
+
     // the distance over which the line edge fades out.
     // Retina devices need a smaller distance to avoid aliasing.
     float ANTIALIASING = 1.0 / DEVICE_PIXEL_RATIO / 2.0;
@@ -160,9 +197,39 @@ mediump float width = u_width;
 
 #ifdef PROJECTION_GLOBE
     float adjustedThickness = projectLineThickness(pos.y);
-    vec4 projected_no_extrude = projectTile(pos + offset2 / u_ratio * adjustedThickness);
+    vec4 projected_no_extrude = projectTileWithElevation(pos + offset2 / u_ratio * adjustedThickness, binchElevation);
     vec2 extrudedPos = pos + (offset2 + dist) / u_ratio * adjustedThickness;
-    gl_Position = projectTile(extrudedPos);
+    gl_Position = projectTileWithElevation(extrudedPos, binchElevation);
+    if (binchArc && binchElevation > 0.0 && u_projection_transition > 0.999) {
+        // Binch: das Band des Bogens im BILDSCHIRMRAUM, quer zur projizierten Richtung samt
+        // Steigung, so breit wie die Linie in Pixeln. Waagerecht im Kachelraum (wie am Boden)
+        // sähe man ein hohes Band im geneigten Blick fast von der Kante — es schrumpfte auf
+        // unter einen Bildpunkt, und Stücke des Bogens verschwanden.
+        vec2 across = normalize(a_extrude) * normal.y; // für beide Punkte des Querschnitts gleich
+        vec2 along = vec2(-across.y, across.x);        // vorwärts, in Richtung wachsenden Fortschritts
+        float stepTile = 8.0 / u_ratio;                // etwa 8 Pixel weiter auf der Linie
+        highp float aheadProgress = binchMercatorLength > 0.0
+                                        ? clamp(binchProgress + stepTile * u_projection_tile_mercator_coords.z /
+                                                                    binchMercatorLength,
+                                                0.0,
+                                                1.0)
+                                        : binchProgress;
+        highp float aheadElevation = binchApexKm * 1000.0 * sin(BINCH_PI * aheadProgress);
+        vec4 here = projected_no_extrude;
+        vec4 ahead = projectTileWithElevation(pos + along * stepTile, aheadElevation);
+        vec2 directionPx = (ahead.xy / ahead.w - here.xy / here.w) * u_units_to_pixels;
+        float lengthPx = length(directionPx);
+        if (lengthPx > 1e-4) {
+            vec2 sidePx = vec2(-directionPx.y, directionPx.x) / lengthPx * outset * normal.y;
+            vec4 ribbon = here + vec4(sidePx / u_units_to_pixels * here.w, 0.0, 0.0);
+            // Am Boden (Flughafen) bleibt die gewöhnliche Linie — dort stimmen beide überein,
+            // und die Enden der Linie (Kappen, Anschlüsse) brauchen die Kachel-Ausrichtung.
+            gl_Position = mix(gl_Position, ribbon, smoothstep(1000.0, 15000.0, binchElevation));
+        }
+        vec3 lifted = projectToSphere(pos + u_projection_translate, vec2(0.0, 0.0)) *
+                      (1.0 + binchElevation / GLOBE_RADIUS);
+        gl_Position.z = binchArcClipZ(lifted) * gl_Position.w - u_projection_depth_offset;
+    }
     v_tile_x = antimeridianClipX(extrudedPos);
     vec4 projected_extrude = gl_Position - projected_no_extrude;
 #else
@@ -183,7 +250,7 @@ mediump float width = u_width;
     lowp float u_blur;
     lowp float u_opacity;
     mediump float u_gapwidth;
-    lowp float u_offset;
+    highp float u_offset;
     mediump float u_width;
     lowp float u_floorwidth;
     lowp float props_pad1;
diff --git a/include/mln/shaders/gl/raster.hpp b/include/mln/shaders/gl/raster.hpp
index fd936ec0..e1bd1763 100644
--- a/include/mln/shaders/gl/raster.hpp
+++ b/include/mln/shaders/gl/raster.hpp
@@ -31,9 +31,12 @@ layout (location = 1) in vec2 a_texture_pos;
 
 out vec2 v_pos0;
 out vec2 v_pos1;
+// Binch: 1 an den Pol-Ecken der Polkappe des Globus, 0 an der Kachelkante (85,05°).
+out float v_pole;
 
 void main() {
     gl_Position = projectTile(a_pos, a_pos);
+    v_pole = (a_pos.y < GLOBE_POLE_NORTH_Y || a_pos.y > GLOBE_POLE_SOUTH_Y) ? 1.0 : 0.0;
     // We are using Int16 for texture position coordinates to give us enough precision for
     // fractional coordinates. We use 8192 to scale the texture coordinates in the buffer
     // as an arbitrarily high number to preserve adequate precision when rendering.
@@ -62,6 +65,32 @@ uniform sampler2D u_image1;
 
 in vec2 v_pos0;
 in vec2 v_pos1;
+in float v_pole;
+
+// Binch: die Polkappe des Globus. Mercator-Kacheln enden bei 85,05°; den Rest bis
+// zum Pol füllt der Globus, indem er die oberste Pixelzeile jeder Kachel bis zum
+// Pol zieht — jedes Pixel ein Strahl, zusammen ein Fächer. Stattdessen wird die
+// Zeile nach innen zunehmend verwischt und läuft dann in EINE feste Polfarbe aus:
+// für alle Kacheln dieselbe, sonst träfen sich am Pol Tortenstücke (die Kanten
+// der Kacheln sind am Nordpol unterschiedlich dunkel). Nord: Polarmeer, wie es
+// Blue Marble und EOX an der Kante zeigen; Süd: Eis.
+const vec3 BINCH_NORTH_POLE = vec3(0.063, 0.141, 0.275);
+const vec3 BINCH_SOUTH_POLE = vec3(0.94, 0.945, 0.945);
+
+vec4 binch_pole_row(sampler2D image, vec2 pos, float lo, float hi, float halfWidth) {
+    // Dicht genug, dass jede Stichprobe an die nächste grenzt (sonst flimmern die
+    // Lücken als neue Speichen).
+    vec4 sum = vec4(0.0);
+    for (int i = 0; i < 16; i++) {
+        float x = clamp(pos.x + halfWidth * (float(i) / 7.5 - 1.0), lo, hi);
+        sum += textureLod(image, vec2(x, pos.y), 0.0);
+    }
+    sum /= 16.0;
+    if (sum.a > 0.0) {
+        sum.rgb /= sum.a;
+    }
+    return sum;
+}
 
 void main() {
 
@@ -74,6 +103,25 @@ void main() {
     if (color1.a > 0.0) {
         color1.rgb = color1.rgb / color1.a;
     }
+    if (v_pole > 0.0) {
+        float lo0 = 0.5 - 0.5 / u_buffer_scale;
+        float hi0 = 0.5 + 0.5 / u_buffer_scale;
+        // Gleich ab der Kante kräftig verwischen (bis ~16 Pixel je Seite bei
+        // 256er-Kacheln, dicht abgetastet) — schmaler blieben Speichen stehen.
+        float halfWidth = 0.004 + 0.06 * smoothstep(0.0, 0.15, v_pole);
+        float smear = smoothstep(0.0, 0.08, v_pole);
+        color0 = mix(color0, binch_pole_row(u_image0, v_pos0, lo0, hi0, halfWidth), smear);
+        color1 = mix(color1,
+                     binch_pole_row(u_image1, v_pos1,
+                                    lo0 * u_scale_parent + u_tl_parent.x,
+                                    hi0 * u_scale_parent + u_tl_parent.x,
